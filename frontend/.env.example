# Backend is now a separate app (see backend/) — this replaces the
# same-origin /api/* calls used before the split.
NEXT_PUBLIC_API_URL=http://localhost:4000

NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_GOVERNANCE_CONTRACT=
NEXT_PUBLIC_TREASURY_CONTRACT=

# Temporary, development-only. When true, the workspace (/overview,
# /sarthi, /proposals, /treasury, /members, /activity, /settings) is
# reachable without a real wallet/onboarding/Samooh, showing fixture data
# instead (see src/lib/demo/). Never enable this in a real deployment.
NEXT_PUBLIC_DEMO_MODE=false
